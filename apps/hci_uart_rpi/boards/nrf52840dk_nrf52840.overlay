/* SPDX-License-Identifier: Apache-2.0 */

/*
 * HCI link to the Raspberry Pi runs on uart1, not uart0.
 * uart0 stays free for the J-Link virtual COM port (debug console),
 * kept separate from the physical HCI link.
 *
 * uart1 default pinctrl (nrf52840dk_nrf52840-pinctrl.dtsi) only assigns
 * RX (P1.01) and TX (P1.02); RTS/CTS are not present there and are added
 * below on free DK pins (P1.00 / P1.09), not used by the Arduino header
 * (D0-D13 = P1.01-P1.08,P1.10-P1.15) or any other on-board peripheral.
 */

/ {
	chosen {
		zephyr,bt-c2h-uart = &uart1;
	};
};

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_RX, 1, 1)>,
				<NRF_PSEL(UART_CTS, 1, 9)>;
			bias-pull-up;
		};

		group2 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>,
				<NRF_PSEL(UART_RTS, 1, 0)>;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_RX, 1, 1)>,
				<NRF_PSEL(UART_TX, 1, 2)>,
				<NRF_PSEL(UART_RTS, 1, 0)>,
				<NRF_PSEL(UART_CTS, 1, 9)>;
			low-power-enable;
		};
	};
};

&uart1 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <1000000>;
	hw-flow-control;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};
