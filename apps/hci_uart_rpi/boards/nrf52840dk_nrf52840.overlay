/* SPDX-License-Identifier: Apache-2.0 */

/*
 * HCI link to the Raspberry Pi runs on uart1, not uart0.
 * uart0 stays free for the J-Link virtual COM port (debug console),
 * kept separate from the physical HCI link.
 *
 * uart1 default pinctrl (nrf52840dk_nrf52840-pinctrl.dtsi) only assigns
 * RX (P1.01) and TX (P1.02); RTS/CTS are not present there and are added
 * below on P1.03 / P1.04. Chosen over P1.00/P1.09 (also free) because
 * P1.03/P1.04 are silkscreened on the DK's Arduino header as D2/D3,
 * making them easy to identify physically; D2/D3 are not used by any
 * on-board peripheral (SPI3 uses D11-D13, i.e. P1.13-15).
 */

/ {
	chosen {
		zephyr,bt-c2h-uart = &uart1;
	};
};

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_RX, 1, 1)>,
				<NRF_PSEL(UART_CTS, 1, 4)>;
			bias-pull-up;
		};

		group2 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>,
				<NRF_PSEL(UART_RTS, 1, 3)>;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_RX, 1, 1)>,
				<NRF_PSEL(UART_TX, 1, 2)>,
				<NRF_PSEL(UART_RTS, 1, 3)>,
				<NRF_PSEL(UART_CTS, 1, 4)>;
			low-power-enable;
		};
	};
};

&uart1 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <1000000>;
	hw-flow-control;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};
