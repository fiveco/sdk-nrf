/* SPDX-License-Identifier: Apache-2.0 */

/*
 * Same HCI link as on the nRF52840-DK: uart1 at 1 Mbaud with hardware flow
 * control, uart0 left for the debug console.
 *
 * The nRF21540-DK carries an nRF52840 as its SoC, and its uart1 pinctrl is
 * identical to the plain DK's - RX on P1.01, TX on P1.02, no RTS/CTS - so
 * the same pins and the same wiring to the Pi apply. RTS/CTS are added here
 * on P1.03/P1.04, silkscreened D2/D3 on the Arduino header.
 *
 * The FEM itself needs nothing here: the board devicetree already declares
 * nrf_radio_fem with its control GPIOs (P0.17/19/20/21/22/23) and SPI, all
 * on port 0 and spi3, so nothing collides with the UART on port 1.
 */

/ {
	chosen {
		zephyr,bt-c2h-uart = &uart1;
	};
};

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_RX, 1, 1)>,
				<NRF_PSEL(UART_CTS, 1, 4)>;
			bias-pull-up;
		};

		group2 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>,
				<NRF_PSEL(UART_RTS, 1, 3)>;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_RX, 1, 1)>,
				<NRF_PSEL(UART_TX, 1, 2)>,
				<NRF_PSEL(UART_RTS, 1, 3)>,
				<NRF_PSEL(UART_CTS, 1, 4)>;
			low-power-enable;
		};
	};
};

&uart1 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <1000000>;
	hw-flow-control;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};
